# MobiMeet — environment variable NAMES with safe placeholders only.
# Copy to .env (git-ignored) and fill with YOUR OWN personal project values. Never commit real values.
# Nothing here is needed for `npm run dev:full` (embedded database, no external accounts).

# ── Core ───────────────────────────────────────────────────
APP_BASE_URL=                               # leave EMPTY on Vercel (derived automatically for production and for every preview). Locally defaults to http://localhost:3000
EXTRA_ALLOWED_ORIGINS=                      # optional comma-separated extra origins allowed to make state-changing requests

# ── Database (production / preview) ────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME   # a PERSONAL PostgreSQL you provision
DATABASE_URL_UNPOOLED=                      # direct (non-pooled) URL, used only to create tables; the Neon–Vercel integration sets it for you
DATABASE_SSL=                               # leave empty: managed databases put sslmode in the URL. "false" only for a local non-TLS database
AUTO_MIGRATE=false                          # "true" applies pending migrations on cold start (otherwise run `npm run db:migrate`)

# ── Road routing for Bike mode ─────────────────────────────
ROUTING_MODE=osrm                           # "osrm" = use a routing service (below) · "estimate" = NO service: labelled straight-line estimates, free
ROUTING_PROVIDER_URL=https://router.project-osrm.org     # public demo = DEVELOPMENT ONLY; use your own OSRM for production
ROUTING_PROFILE=driving
ROUTING_MIN_INTERVAL_MS=1100                # 1100 for the public demo's fair-use limit; 0 for a private server
ROUTING_API_KEY=                            # only for a hosted OSRM-compatible gateway that needs one (sent server-side)
ROUTING_API_KEY_HEADER=                     # header name for the key (default: Authorization → "Bearer <key>")
ALLOW_PUBLIC_OSRM_IN_PRODUCTION=false       # leave false: the public demo is refused in production-like deployments

# ── Venues ─────────────────────────────────────────────────
VENUE_RADIUS_KM=2.5                         # default search radius around a meetup point (0.5–5 km); users can change it per search
OVERPASS_URL=                               # optional Overpass endpoint override

# ── LLM (optional — everything works deterministically without it; keys are SERVER-SIDE ONLY) ──
LLM_PROVIDER=                               # "groq", "anthropic" or "openai" — only needed if more than one key is set
GROQ_API_KEY=                               # starts with gsk_ — put it here in YOUR private .env, never in chat or Git
GROQ_MODEL=openai/gpt-oss-20b
# Budget protections for model calls (shared across all instances through the database). Defaults sit below Groq's free limits; raise on a paid plan.
LLM_MAX_PER_MINUTE=10                       # all users, requests per minute
LLM_MAX_PER_DAY=300                         # all users, requests per day (UTC)
LLM_MAX_TOKENS_PER_MINUTE=6000              # all users, estimated tokens per minute
LLM_MAX_TOKENS_PER_DAY=150000               # all users, estimated tokens per day (UTC)
LLM_MAX_PER_USER_10MIN=12                   # one person, per 10 minutes
LLM_MAX_PER_GROUP_HOUR=60                   # one group, per hour               # run `npm run llm:check` to list the models your key can use
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Scheduled maintenance (retention) ──────────────────────
CRON_SECRET=                                # long random string; enables GET /api/maintenance for the daily cron

# Password-reset email. outbox = links go to a local development outbox only (nothing is sent). No real email provider is configured yet.
MAIL_MODE=outbox                            # outbox (dev only, nothing sent) | resend (real email, needs the two lines below) | disabled
RESEND_API_KEY=                             # re_... from resend.com → API Keys (server-side only)
MAIL_FROM=                                  # e.g. MobiMeet <no-reply@yourdomain> — must be on a domain you verified in Resend
